# Cloudflare Pages / Netlify both read this file.
# Cloudflare validates it at deploy time and rejects the build on a syntax error.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=()

# Static assets are content-addressed by filename here, so a long cache is safe
# as long as you bump the filename when you change a file. If you edit style.css
# in place, change this to max-age=3600 instead.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# HTML must revalidate, otherwise visitors keep seeing a stale homepage after
# a deploy for as long as the edge caches it.
/*.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate

