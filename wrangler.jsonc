{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "toolbench-tools",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-23",

  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },

  "workers_dev": true,
  "preview_urls": false,

  "observability": {
    "enabled": true
  }
}
